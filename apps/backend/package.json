{
  "name": "@shop-assist/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "build": "echo 'No build step for Python'",
    "lint": "uv run ruff check . && uv run mypy .",
    "format": "uv run ruff format . && uv run isort .",
    "typecheck": "uv run mypy .",
    "test": "uv run pytest",
    "test:watch": "uv run pytest --watch",
    "db:push": "uv run alembic upgrade head",
    "db:makemigrations": "uv run alembic revision --autogenerate -m",
    "db:migrate": "uv run alembic upgrade head",
    "db:studio": "echo 'Use DBeaver or pgAdmin for database management'"
  }
}