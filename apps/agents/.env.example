# Application
APP_NAME=Shop Assist Agents
APP_VERSION=1.0.0
DEBUG=true

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo-preview
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=4096

# Backend API
BACKEND_API_URL=http://localhost:8000/api/v1
BACKEND_API_KEY=

# LiveKit — voice agent worker registration (src/agents/voice/livekit_agent.py).
# Same project as apps/frontend/.env (which mints room tokens for browsers);
# these register this process as a job worker instead. From
# https://cloud.livekit.io.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Gemini — Live API (speech-to-speech) for the LiveKit voice agent.
# Separate from OPENAI_API_KEY/ANTHROPIC_API_KEY above, which back the
# text-only ChatAgent/SupervisorAgent. Get one at https://aistudio.google.com/apikey.
GOOGLE_API_KEY=

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Voice
WHISPER_MODEL=base
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=1024

# Agent Behavior
MAX_ITERATIONS=10
AGENT_TIMEOUT=300
ENABLE_STREAMING=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json