# Frontend environment variables. Copy to .env.local for local overrides.

# Backend API base URL used by src/lib/api.ts
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only — never prefix with NEXT_PUBLIC_, this key must not reach the
# browser. Used by src/app/api/location/reverse-geocode/route.ts to resolve
# the customer's device coordinates into a pincode/area.
# Get one at https://console.cloud.google.com/google/maps-apis with the
# Geocoding API enabled and billing set up. Restrict the key to the
# Geocoding API only (an HTTP-referrer restriction won't help — this call is
# server-to-server, so Google sees your server's IP, not a browser referrer).
GOOGLE_MAPS_API_KEY=

# Server-only — LiveKit project credentials (used to mint room-access tokens
# server-side and, for LIVEKIT_URL, by the client to connect to the room).
# From your project at https://cloud.livekit.io.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
